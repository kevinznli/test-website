# Optional. Copy to backend/.env to override defaults. No API keys are needed.
# (Named env.example because .gitignore excludes .env.* files.)

USER_AGENT=UCSD-Risk-Resource-NotForProfit
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
UPSTREAM_TIMEOUT_SECONDS=15

# Cache lifetimes, in seconds
FEEDS_TTL_SECONDS=300
SNAPSHOT_TTL_SECONDS=60
WEATHER_TTL_SECONDS=1800
GAUGES_TTL_SECONDS=900
GEOCODE_TTL_SECONDS=86400
